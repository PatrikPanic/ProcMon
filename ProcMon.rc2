//
// ProcMon.rc2 - resursi koje Visual Studio ne uredjuje
//
// Ovu datoteku glavni ProcMon.rc automatski ukljucuje (TEXTINCLUDE 3),
// pa se svi ovdje navedeni stringovi normalno prevode u aplikaciju.
// Resource Editor ih ne prikazuje, ali su i dalje dio resursa, ne koda.
//

#ifdef APSTUDIO_INVOKED
#error this file is not editable by Microsoft Visual C++
#endif //APSTUDIO_INVOKED

#include "..\StringIDs.h"

#pragma code_page(65001)    // datoteka je spremljena u UTF-8 kodnoj stranici

/////////////////////////////////////////////////////////////////////////////
//
// Tablica stringova aplikacije
//
// LANGUAGE 0, 0 znaci jezicno neutralne resurse. Tako ih Windows pronalazi
// bez obzira na jezik sustava i na jezik ostalih resursa u projektu.
//

LANGUAGE 0, 0

STRINGTABLE
BEGIN
    // Ribbon
    IDS_RIBBON_CATEGORY     "Pregled"
    IDS_PANEL_REFRESH       "Osvježavanje"
    IDS_PANEL_PROCESS       "Odabrani proces"
    IDS_PANEL_FILTER        "Filtar"
    IDS_PANEL_VIEW          "Prikaz"
    IDS_CMD_REFRESH         "Osvježi"
    IDS_CMD_AUTOREFRESH     "Automatski (1 s)"
    IDS_CMD_KILL            "Prekini proces"
    IDS_CMD_TREE            "Stablo procesa"
    IDS_FILTER_LABEL        "Naziv:"
    IDS_STATUS_READY        "Spremno"

    // Naslovi kartica
    IDS_TITLE_PROCESSES     "Procesi"
    IDS_TITLE_THREADS       "Dretve"
    IDS_TITLE_MODULES       "Moduli"

    // Stupci popisa procesa
    IDS_COL_PID             "PID"
    IDS_COL_NAME            "Naziv procesa"
    IDS_COL_CPU             "CPU (%)"
    IDS_COL_WORKINGSET      "RAM"
    IDS_COL_PRIVATE         "Privatna memorija"
    IDS_COL_THREADCOUNT     "Broj dretvi"
    IDS_COL_PATH            "Putanja"

    // Stupci popisa dretvi
    IDS_COL_TID             "ID dretve"
    IDS_COL_PRIORITY        "Prioritet"
    IDS_COL_KERNELTIME      "Vrijeme u jezgri"
    IDS_COL_USERTIME        "Korisničko vrijeme"
    IDS_COL_CREATED         "Nastanak"

    // Stupci popisa modula
    IDS_COL_MODULE          "Modul"
    IDS_COL_BASEADDRESS     "Bazna adresa"
    IDS_COL_SIZE            "Veličina"
    IDS_COL_MODULEPATH      "Putanja"

    // Poruke
    IDS_STATUS_FORMAT       "Procesa: %d          Ukupno RAM: %s          %s          Osvježeno: %s"
    IDS_STATUS_SELECTED     "Odabrano: %s (PID %u)"
    IDS_STATUS_NO_SELECTION "Nije odabran proces"
    IDS_NOT_AVAILABLE       "nedostupno"
    IDS_THREADS_NO_SELECTION "Odaberite proces u kartici Procesi."
    IDS_MODULES_DENIED      "Popis modula nije dostupan za ovaj proces."
    IDS_CONFIRM_KILL        "Želite li stvarno prekinuti proces %s (PID %u)?\n\nNespremljeni podaci tog programa bit će izgubljeni."
    IDS_CONFIRM_KILL_TREE   "Proces %s (PID %u) pokrenuo je još %d procesa.\n\nŽelite li prekinuti proces zajedno sa svim procesima koje je pokrenuo?\n\nNespremljeni podaci tih programa bit će izgubljeni."
    IDS_ERR_KILL_FAILED     "Proces %s (PID %u) nije moguće prekinuti.\n\nGreška sustava %u: %s\n\nNeke procese štiti sam operacijski sustav i ne mogu se prekinuti ni s administratorskim ovlastima."
    IDS_ERR_NO_SELECTION    "Najprije odaberite proces u popisu."
    IDS_WARN_NO_DEBUG_PRIV  "Aplikaciji nije dodijeljena ovlast za pregled tuđih procesa. Podaci o sistemskim procesima bit će nepotpuni.\n\nPokrenite aplikaciju kao administrator."
END

